@page "/register"
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Register</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small">
    <MudPaper Class="pa-6" Elevation="3">
        <MudText Typo="Typo.h5" Class="mb-4">Create account</MudText>

        <EditForm Model="_model" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="_model.FullName" For="@(() => _model.FullName)"
                          Label="Full name" Variant="Variant.Outlined" Class="mb-3" />

            <MudTextField @bind-Value="_model.Email" For="@(() => _model.Email)"
                          Label="Email" Variant="Variant.Outlined" Class="mb-3" />

            <MudTextField @bind-Value="_model.Password" For="@(() => _model.Password)"
                          Label="Password" InputType="InputType.Password"
                          Variant="Variant.Outlined" Class="mb-3" />

            <MudTextField @bind-Value="_model.ConfirmPassword" For="@(() => _model.ConfirmPassword)"
                          Label="Confirm password" InputType="InputType.Password"
                          Variant="Variant.Outlined" Class="mb-3" />

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                       Color="Color.Primary" FullWidth="true">
                Register
            </MudButton>
        </EditForm>

        <MudText Class="mt-3">Already have an account? <MudLink Href="login">Login</MudLink></MudText>
    </MudPaper>
</MudContainer>

@code {
    RegisterModel _model = new();

    void HandleRegister()
    {
        Snackbar.Add("Account created (placeholder)", Severity.Success);
        Nav.NavigateTo("login");
    }

    public class RegisterModel
    {
        [Required(ErrorMessage = "Name is required")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Enter a valid email")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        [MinLength(6, ErrorMessage = "At least 6 characters")]
        public string Password { get; set; } = "";

        [Compare(nameof(Password), ErrorMessage = "Passwords do not match")]
        public string ConfirmPassword { get; set; } = "";
    }
}