@page "/staff/dashboard"
@inject OrderService OrderSvc

<PageTitle>Staff Dashboard</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Staff Dashboard</MudText>

<MudGrid>
    @foreach (var s in Enum.GetValues<OrderStatus>())
    {
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Class="pa-3" Elevation="2">
                <MudText Typo="Typo.subtitle2">@s</MudText>
                <MudText Typo="Typo.h5">@_orders.Count(o => o.Status == s)</MudText>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudButton Class="mt-4" Variant="Variant.Filled" Color="Color.Primary" Href="staff/update-status">
    Update Order Status
</MudButton>

@code {
    List<Order> _orders = new();

    protected override async Task OnInitializedAsync()
    {
        _orders = await OrderSvc.GetAllAsync();
    }
}